# Required for the ESLint baseline on TypeScript 7 (see tools/eslint-typescript-shim.mjs):
# the latest stable typescript-eslint still declares `typescript < 6.1` as a
# peer, which conflicts with the project's TypeScript 7.0.2. Legacy peer
# handling lets install/ci resolve while the lockfile pins every version.
# Remove together with the shim once a stable typescript-eslint supports TS 7.
legacy-peer-deps=true
