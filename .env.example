# Development-only example. Never commit real credentials.
# Copy to .env (gitignored) for local database work.
DATABASE_URL=postgresql://lusio:lusio@localhost:5433/lusio
APP_ORIGIN=http://localhost:8080
TRUST_PROXY_HEADERS=false
ENABLE_HSTS=false

# Bootstrap admin (used only by db:seed; change before production)
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-production
ADMIN_BOOTSTRAP_NAME=مدیر فروشگاه

# Session cookies
SESSION_COOKIE_SECURE=false

# Customer OTP: "development" prints the code to the server console only.
OTP_PROVIDER=development
MESSAGE_PROVIDER=development
OTP_HASH_SECRET=change-me-to-a-long-random-secret
TRANSACTIONAL_MESSAGES_ENABLED=false
MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=
OTP_TEMPLATE_KEY=login
# For OTP_PROVIDER=webhook (POST JSON: phone, code, template)
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
OTP_WEBHOOK_TEMPLATE=login

# Safe until a real adapter is implemented. Never reports success.
PAYMENT_PROVIDER=none

# Media storage: local writes to public/uploads. Use "s3" in production.
MEDIA_STORAGE_DRIVER=local
MEDIA_MAX_BYTES=8388608
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
